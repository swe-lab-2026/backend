# --- App -------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_NAME=BiletFlow API
API_PREFIX=/api/v1
# Comma-separated origins for Next.js (web) and React Native dev server.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Database --------------------------------------------------------------
# Postgres via docker compose (or any asyncpg URL).
DATABASE_URL=postgresql+asyncpg://biletflow:biletflow@localhost:5432/biletflow
# Empty -> in-process TTL store used for rate limiting (dev only).
REDIS_URL=

# --- Auth / JWT ------------------------------------------------------------
# Generate real values with: openssl rand -hex 32
# Access and refresh tokens use DIFFERENT secrets. Never use these examples.
JWT_ACCESS_SECRET=change-me-please-use-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-please-use-openssl-rand-hex-32-different
JWT_ALGORITHM=HS256
JWT_ISSUER=biletflow-api
JWT_AUDIENCE=biletflow-clients
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Email verification ----------------------------------------------------
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_PER_HOUR=5
EMAIL_FROM=BiletFlow <no-reply@biletflow.local>

# --- Login brute-force protection -------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15