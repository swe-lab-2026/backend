# --- App -------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_NAME=BiletFlow API
API_PREFIX=/api/v1
# Comma-separated origins for Next.js (web) and React Native dev server.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Database --------------------------------------------------------------
# Postgres via docker compose (or any asyncpg URL).
DATABASE_URL=postgresql+asyncpg://biletflow:biletflow@localhost:5432/biletflow
# Empty -> in-process TTL store used for rate limiting (dev only).
REDIS_URL=

# --- Auth / JWT ------------------------------------------------------------
# Generate real values with: openssl rand -hex 32
# Access and refresh tokens use DIFFERENT secrets. Never use these examples.
JWT_ACCESS_SECRET=change-me-please-use-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-please-use-openssl-rand-hex-32-different
JWT_ALGORITHM=HS256
JWT_ISSUER=biletflow-api
JWT_AUDIENCE=biletflow-clients
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Email verification ----------------------------------------------------
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_PER_HOUR=5
# Reused as the Brevo sender when BREVO_SENDER_EMAIL/NAME are empty.
# Production requires a real deliverable address (not *.local).
EMAIL_FROM=BiletFlow <no-reply@biletflow.local>

# --- Transactional email delivery ------------------------------------------
# dev   -> log-only provider for local development
# brevo -> Brevo transactional email REST API (required in production)
EMAIL_PROVIDER=dev
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=BiletFlow
BREVO_API_BASE_URL=https://api.brevo.com
BREVO_TIMEOUT_SECONDS=10

# --- Login brute-force protection -------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Password reset --------------------------------------------------------
PASSWORD_RESET_TTL_MINUTES=30
# Page or app deep link the reset email opens; the backend appends
# ?token=...&email=... Empty -> {PUBLIC_WEB_BASE_URL}/reset-password. Use an
# https URL (claimable as an App Link / Universal Link) or an app scheme such as
# biletflow://reset-password. With neither set, the email shows the raw token.
PASSWORD_RESET_URL=

# --- Tickets and checkout --------------------------------------------------
# Separate secret used to sign QR admission payloads (defaults to access secret).
TICKET_QR_SECRET=
# Public origin used in ticket download links, e.g. https://api.biletflow.kz
PUBLIC_BASE_URL=
# Public HTTPS origin of the customer web app. Campaign QR codes encode
# {PUBLIC_WEB_BASE_URL}/campaigns/{campaign_token}. Leave empty until the web
# route exists; the API then returns only the token and relative path.
PUBLIC_WEB_BASE_URL=
ORDER_RESERVATION_TTL_MINUTES=10
RESERVATION_CLEANUP_INTERVAL_SECONDS=60
RESERVATION_CLEANUP_ENABLED=true
NOTIFICATION_RETRY_INTERVAL_SECONDS=60
NOTIFICATION_MAX_ATTEMPTS=5
# Exponential backoff between outbox attempts, capped at the max value.
NOTIFICATION_RETRY_BASE_SECONDS=30
NOTIFICATION_RETRY_MAX_SECONDS=3600
# Orders closed per committed batch when an event is cancelled; an interrupted
# cancellation resumes from the remaining orders (retry or background sweep).
EVENT_CANCELLATION_BATCH_SIZE=100
